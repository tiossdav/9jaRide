DATABASE_URL=postgres://jaride:jaride@localhost:5432/jaride
REDIS_URL=redis://localhost:6379
# Dispatch (spec defaults)
OFFER_TIMEOUT_SECONDS=15
SEARCH_WINDOW_SECONDS=90
SEARCH_RADII_KM=3,5,8
# Safety
SOS_ESCALATION_SECONDS=60
ONCALL_PHONE=
# Payments (placeholder policy values; Paystack test keys for dev)
PAYSTACK_SECRET_KEY=
PAYMENT_EMAIL_DOMAIN=example.invalid
TOPUP_MIN_KOBO=10000
TOPUP_MAX_KOBO=50000000
PAYOUT_MIN_KOBO=100000
PAYOUT_STUCK_SECONDS=1800
# Auth (JWT_SECRET: 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_SECRET=
ACCESS_TOKEN_SECONDS=900
# HTTP
PORT=3000
TRUST_PROXY=
ADMIN_ORIGIN=
ADJUSTMENT_ADMIN_THRESHOLD_KOBO=5000000
# Scheduled rides (placeholders)
SCHEDULE_MIN_LEAD_MINUTES=30
SCHEDULE_MAX_DAYS_AHEAD=30
SCHEDULE_MAX_WEEKS=12
SCHEDULE_MAX_OPEN=30
SCHEDULE_SEARCH_LEAD_MINUTES=15
SCHEDULE_SEARCH_WINDOW_SECONDS=600
SCHEDULE_MISSED_GRACE_MINUTES=10
# Trip distance check (placeholders)
TRAIL_MIN_POINTS=10
TRAIL_FLAG_RATIO=1.3
TRAIL_FLAG_MIN_EXCESS_M=1000

# One-time codes. "test" (the default) = every code is 0000 and nothing is sent. Set "live" to send real codes through
# Termii (needs TERMII_API_KEY). A production start refuses "test".
OTP_MODE=test
# Termii (https://termii.com). Keep the key on the server only, never in git.
# TERMII_API_KEY=
# TERMII_SENDER_ID=      # must be approved on your Termii account; until then Termii's shared "N-Alert" works
# TERMII_CHANNEL=generic # or "dnd" to reach numbers that block promotional texts
# TERMII_BASE_URL=https://api.ng.termii.com  # use the address shown on your Termii dashboard if it differs

# Where uploaded photos and documents go: a folder (default, UPLOAD_DIR) or "db" to keep them in the database.
# FILE_STORAGE=db

# Google Maps, asked by the server for the apps: place search, addresses and routes (Places API (New), Geocoding API, Routes API).
# Keep it on the server only. Without it, search says it is not set up and routes fall back to a marked estimate.
# GOOGLE_MAPS_API_KEY=
